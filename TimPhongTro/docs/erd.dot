  PhongYeuThich [label="{PhongYeuThich|maYeuThich (PK)\lmaNguoiDung (FK)\lmaPhong (FK)\lngayLuu\l}"];
  YeuCau [label="{YeuCau|maYeuCau (PK)\lmaNguoiDung (FK)\lmaPhong (FK)\lhoTenLienHe\lsoDienThoaiLienHe\lloiNhan\ltrangThai\lngayTao\l}"];

  NguoiDung -> Phong [label="1 - N (dang tin)"];
